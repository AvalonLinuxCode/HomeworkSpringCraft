<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.eduplatform.mapper.InstructorMapper">

    <sql id="keywordFilter">
        <if test="keyword != null">
            AND name LIKE CONCAT('%', #{keyword}, '%')
        </if>
    </sql>

    <select id="list" resultType="com.eduplatform.entity.Instructor">
        SELECT id, name, avatar, title, description, created_at, updated_at
        FROM instructor
        <where>
            <if test="keyword != null">
                AND name LIKE CONCAT('%', #{keyword}, '%')
            </if>
        </where>
        ORDER BY id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*)
        FROM instructor
        <where>
            <if test="keyword != null">
                AND name LIKE CONCAT('%', #{keyword}, '%')
            </if>
        </where>
    </select>

    <select id="countCoursesByInstructorId" resultType="long">
        SELECT COUNT(*) FROM course WHERE instructor_id = #{instructorId}
    </select>
</mapper>
